NEXT_PUBLIC_API_URL=http://localhost:4000

# Echo5 Leads Manager (server-side only — do not prefix with NEXT_PUBLIC_)
ECHO5_API_URL=https://echo-5-leads-fxzz.vercel.app
ECHO5_TENANT_KEY=op_55a31454bdb955c5a904c2394521a87b

# Google reCAPTCHA v2 Checkbox (site key is public/client-side, secret key is server-only)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_site_key
RECAPTCHA_SECRET_KEY=your_secret_key

# SMTP email notifications — fill in with real credentials to enable team notification emails.
# Until these are set, lead submission will skip sending and log a warning instead of failing.
SMTP_FROM_NAME=Open Arms Initiative
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=app-password
SMTP_FROM=you@example.com
# Comma-separated list of recipients notified on every new lead / eligibility submission.
TEAM_NOTIFICATION_EMAIL=team@example.com
# Optional comma-separated list of additional recipients to CC on every notification.
TEAM_NOTIFICATION_CC=
