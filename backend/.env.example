PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/openarms?appName=Cluster0
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGIN=http://localhost:3000

ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me
ADMIN_SEED_NAME=Admin

# SMTP email notifications — fill in with real credentials to enable team notification emails.
# Until these are set, the app will skip sending and log a warning instead of failing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=app-password
SMTP_FROM=you@example.com
TEAM_NOTIFICATION_EMAIL=team@example.com
# Optional comma-separated list of additional recipients to CC on every notification.
TEAM_NOTIFICATION_CC=jamie@example.com,sony@example.com
